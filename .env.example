# Copy to .env.local (Next.js loads it automatically; never commit)

# OpenAI — without this, MVP falls back to keyword heuristics (conservative)
OPENAI_API_KEY=

# Model for analysis (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Google Books — strongly recommended; unauthenticated requests hit low quotas fast
GOOGLE_BOOKS_API_KEY=

# Set to "true" to force all analyses to fail (testing trust rules)
FORCE_ANALYSIS_FAILURE=false
